    "platforms": [
      "Mac"
    ]
  },
  {
    "id": "builtin:python_install_ubuntu",
    "name": "安装 Python · Ubuntu/Debian",
    "command": "sudo apt-get update && sudo apt-get install python3 python3-pip python3-venv",
    "platforms": [
      "Posix"
    ]
  },
  {
    "id": "builtin:python_install_fedora",
    "name": "安装 Python · Fedora",
    "command": "sudo dnf install python3 python3-pip",
    "platforms": [
      "Posix"
    ]
  },
  {
    "id": "builtin:git_install_windows",
    "name": "安装 Git · Windows",
